# ==============================================================================
# Financial Fraud Analytics & Real-Time ML - Template Environment Configuration
# Copy this file to .env and adjust values as needed: cp .env.example .env
# ==============================================================================

# --- ClickHouse OLAP Database Configuration ---
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=your_secure_password_here
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_TCP_PORT=9000
CLICKHOUSE_DB_SCHEMA=fraud_detection

# --- MLflow Tracking & Registry Configuration ---
MLFLOW_HOST=mlflow
MLFLOW_PORT=5000
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_EXPERIMENT_NAME=Détection_Fraude_Financière

# --- FastAPI Real-Time Serving Configuration ---
API_HOST=0.0.0.0
API_PORT=8000
